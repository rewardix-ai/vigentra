# Sentinel Module 1 - environment template.
#
# Copy to `.env` and edit before running `docker compose up`. Every value below
# has a working demo default; you only need to change JWT_SECRET and the
# department credentials for anything beyond a local demo.
#
# Module 1 is METADATA-ONLY. There is no video-related setting in this file,
# because there is no video path in the service.

# --- central-api ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel
JWT_SECRET=change-me-in-anything-that-is-not-a-local-demo
ENVIRONMENT_LABEL=DEMO / MODULE 1
DISPLAY_TIMEZONE=Asia/Kolkata
AUTO_SYNC_ON_STARTUP=true
HEALTH_MONITOR_ENABLED=true
HEALTH_POLL_INTERVAL_SECONDS=20
UPSTREAM_TIMEOUT_SECONDS=6
UPSTREAM_RETRIES=1

# --- traffic-vms (Gujarat Traffic Police) --------------------------------
TRAFFIC_VMS_BASE_URL=http://traffic-vms:8001
TRAFFIC_VMS_API_KEY=traffic-demo-key
TRAFFIC_VMS_DEPARTMENT=Traffic Police
TRAFFIC_VMS_DISTRICT=Ahmedabad

# --- municipal-vms (Municipal Corporation) -------------------------------
MUNICIPAL_VMS_BASE_URL=http://municipal-vms:8002
MUNICIPAL_VMS_TOKEN=municipal-demo-token
MUNICIPAL_VMS_DEPARTMENT=Municipal Corporation
MUNICIPAL_VMS_DISTRICT=Ahmedabad

# --- dashboard -----------------------------------------------------------
CENTRAL_API_URL=http://central-api:8000
# The demo stack runs on plain HTTP over localhost. Set this to `1` only when
# the dashboard is served over TLS, otherwise the session cookie will never be
# stored.
SENTINEL_SECURE_COOKIE=

# --- demo accounts (optional override) -----------------------------------
# Override the built-in demo accounts by pasting the full JSON list here.
# Otherwise DEFAULT_DEMO_USERS in services/central-api/app/config.py applies.
# DEMO_USERS_JSON=[{"username":"…","password":"…","display_name":"…","role":"…","department":"…"}]
