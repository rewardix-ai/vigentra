# Vigentra Module 1 - environment template.
#
# Copy to `.env` and edit before running `docker compose up`. Every value below
# has a working demo default; you only need to change JWT_SECRET and the
# department credentials for anything beyond a local demo.
#
# Module 1 is METADATA-ONLY. There is no video-related setting in this file,
# because there is no video path in the service.

# --- central-api ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel
JWT_SECRET=change-me-in-anything-that-is-not-a-local-demo
ENVIRONMENT_LABEL=DEMO / MODULE 1
DISPLAY_TIMEZONE=Asia/Kolkata
AUTO_SYNC_ON_STARTUP=true
HEALTH_MONITOR_ENABLED=true
HEALTH_POLL_INTERVAL_SECONDS=20
UPSTREAM_TIMEOUT_SECONDS=6
UPSTREAM_RETRIES=1
# The grid is a shared sandbox on the public internet behind a sign-in, not a
# VMS on the department LAN. It answers in well under a second once warm and
# takes tens of seconds on the first connection; the LAN budget above marked
# both departments offline on every cold start.
GRID_UPSTREAM_TIMEOUT_SECONDS=25
GRID_UPSTREAM_RETRIES=2

# --- traffic-vms (Gujarat Traffic Police) --------------------------------
# The two demo department systems carry SYNTHETIC cameras. Set both to false
# to run against real sources only - the registry then federates nothing
# invented, and cameras from a disabled source are removed on the next sync.
# They stay in the tree because the cross-unit grant flow needs a second
# department to demonstrate, and the test-suite exercises them.
TRAFFIC_VMS_ENABLED=false
MUNICIPAL_VMS_ENABLED=false

TRAFFIC_VMS_BASE_URL=http://traffic-vms:8001
TRAFFIC_VMS_API_KEY=traffic-demo-key
TRAFFIC_VMS_DEPARTMENT=Traffic Police
TRAFFIC_VMS_DISTRICT=Ahmedabad

# --- municipal-vms (Municipal Corporation) -------------------------------
MUNICIPAL_VMS_BASE_URL=http://municipal-vms:8002
MUNICIPAL_VMS_TOKEN=municipal-demo-token
MUNICIPAL_VMS_DEPARTMENT=Municipal Corporation
MUNICIPAL_VMS_DISTRICT=Ahmedabad

# --- dashboard -----------------------------------------------------------
CENTRAL_API_URL=http://central-api:8000
# The demo stack runs on plain HTTP over localhost. Set this to `1` only when
# the dashboard is served over TLS, otherwise the session cookie will never be
# stored.
VIGENTRA_SECURE_COOKIE=

# --- demo accounts (optional override) -----------------------------------
# Override the built-in demo accounts by pasting the full JSON list here.
# Otherwise DEFAULT_DEMO_USERS in services/central-api/app/config.py applies.
# DEMO_USERS_JSON=[{"username":"…","password":"…","display_name":"…","role":"…","department":"…"}]

# --- Sentinel sandbox camera grid (REAL upstream, 30 live cameras) ----------
# https://sentinel.gujarat.gov.in/resource  -  see docs/sentinel-grid.md
SENTINEL_GRID_ENABLED=true
SENTINEL_GRID_BASE_URL=https://cctv.corp8.cloud
# The access password. Posted to /auth/login for the HLS session cookie, and
# since 2026-09-10 also embedded (percent-encoded) with the email in every
# RTSP/WHEP URL the edge worker opens - the gateway refuses a bare URL. The
# worker redacts it from every log line and report.
SENTINEL_GRID_PASSWORD=
# The gateway's sign-in form now takes the registered participant
# address alongside the access password, and answers a pair it does not
# recognise with 403. Leave empty only against a gateway still running
# the older password-only form.
SENTINEL_GRID_EMAIL=
# RTSP is served off the CDN, direct on the public gateway.
SENTINEL_GRID_RTSP_HOST=103.250.160.189
# The live wall shows still frames the edge worker decodes over the fast
# RTSP gateway, because the grid HLS CDN is far too slow to feed a browser
# player. central-api proxies them from here (the snapshot_wall service).
EDGE_SNAPSHOT_URL=http://edge-worker:9100
# Used only when cameras.json is unreachable: the documented camera ids.
# SENTINEL_GRID_FALLBACK_IDS=cam01,cam02,...,cam30
# Surveyed coordinates / view direction / camera class. The grid publishes
# none of these; regenerate with scripts/compile_grid_reference.py.
SENTINEL_GRID_REFERENCE=/app/reference/grid_cameras.json
