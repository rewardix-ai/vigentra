# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.pytest-sentinel.sqlite

# Node / Next.js
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Local configuration - never commit real credentials
.env
.env.local
.env.*.local

# OS
Thumbs.db
.DS_Store

# Local demo binaries and video fixtures
*.mp4
cloudflared.exe
weights/*.pt
# Ultralytics downloads a missing model into the process working directory, so
# stray copies appear at the repo root and beside the edge worker. The weights
# belong in weights/ or ANPR_MODELS_DIR, never in a commit.
*.pt

# Local agent configuration and scratch files
.claude/settings.local.json
.claude/_scratch/

# Intermediate research artifacts from compiling the grid reference. The
# scripts that produced them are committed; the raw geocoder/catalogue dumps
# are reproducible and just noise in a diff.
data/reference/_*.json

# Generated copy of the grid reference. The source of truth is
# data/reference/grid_cameras.json, which the Dockerfile bakes into the image.
# Two committed copies drift - that is how the wrong-shape file shipped once.
services/central-api/reference/
