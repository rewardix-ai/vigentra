# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.pytest-vigentra.sqlite

# Local run databases. The schema is created on startup and the contents are
# whatever that machine happened to sync and detect, so a committed copy is
# one developer's run history presented as project state - and it conflicts on
# every pull.
*.sqlite
*.sqlite-journal

# Node / Next.js
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Local configuration - never commit real credentials
.env
.env.local
.env.*.local

# OS
Thumbs.db
.DS_Store

# Local demo binaries and video fixtures
*.mp4
cloudflared.exe
weights/*.pt
# Ultralytics downloads a missing model into the process working directory, so
# stray copies appear at the repo root and beside the edge worker. The weights
# belong in weights/ or ANPR_MODELS_DIR, never in a commit.
*.pt

# Local agent configuration and scratch files
.claude/settings.local.json
.claude/_scratch/

# Intermediate research artifacts from compiling the grid reference. The
# scripts that produced them are committed; the raw geocoder/catalogue dumps
# are reproducible and just noise in a diff.
data/reference/_*.json

# Generated copy of the grid reference. The source of truth is
# data/reference/grid_cameras.json, which the Dockerfile bakes into the image.
# Two committed copies drift - that is how the wrong-shape file shipped once.
services/central-api/reference/

# Runtime logs from the local stack.
logs/

# Generated ANPR dataset artifacts. The images and labels are derived - rebuild
# them with services/edge-worker/tools/prepare_dataset.py from the capture
# corpus. The manifest, metadata and reports ARE committed: they are the
# provenance record and are small.
services/edge-worker/dataset/*/images/
services/edge-worker/dataset/*/labels/
services/edge-worker/dataset/*/review/
services/edge-worker/runs/
services/edge-worker/dataset/*/train_oversampled_*.txt
services/edge-worker/dataset/*/data_oversampled_*.yaml
# Training and probe logs churn on every run; the JSON summaries are
# the provenance record and stay committed.
services/edge-worker/reports/*.log
# Error-analysis contact sheets are derived images, like review/.
services/edge-worker/reports/error_analysis/

services/edge-worker/dataset/*/stage*.txt
services/edge-worker/dataset/*/stage*.yaml
services/edge-worker/reports/synth_smoke_sheet.jpg
services/edge-worker/reports/hard_first_stdout.log
